# Copy this file to `.env` and fill in the values.

# Umami analytics (required — the app throws at render if they are missing).
UMAMI_WEBSITE_ID=
UMAMI_SCRIPT_URL=

# IONOS SMTP account credentials (smtp.ionos.fr:465) used by the
# `POST /sendMail` route: messages are sent from `EMAIL_USER` to `EMAIL_USER`.
EMAIL_USER=
EMAIL_PASSWORD=

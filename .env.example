# Copy this file to `.env` and fill in the values.

# Google Analytics measurement ID (required — the app throws at render if it is
# missing).
GOOGLE_ANALYTICS_GA=

# IONOS SMTP account credentials (smtp.ionos.fr:465) used by the
# `POST /sendMail` route: messages are sent from `EMAIL_USER` to `EMAIL_USER`.
EMAIL_USER=
EMAIL_PASSWORD=

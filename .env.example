# Studio project ID. Keep it aligned with SANITY_PROJECT_ID.
SANITY_STUDIO_PROJECT_ID=project_id
# Required for `bun run build`; must match SANITY_DATASET. Use `dev` locally
# and `production` in production.
SANITY_STUDIO_DATASET=dev

# Sanity project and dataset read by the public site at build time.
SANITY_PROJECT_ID=project_id
SANITY_DATASET=dev
SANITY_API_VERSION=2026-09-23

RESEND_API_KEY=re_...
